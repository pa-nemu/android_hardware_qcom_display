
cc_library_shared {

    name: "libsdmutils",
    defaults: ["qtidisplay_defaults"],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,

    header_libs: ["display_headers"],
    cflags: ["-DLOG_TAG=\"SDM\""],
    srcs: select(soong_config_variable("qtidisplay", "common_kailua_sdm"), {
        true: [":qtidisplay_kailua_utils_sources"],
        default: [
        "debug.cpp",
        "rect.cpp",
        "sys.cpp",
        "fence.cpp",
        "formats.cpp",
        "utils.cpp",
    ],
    }),

    shared_libs: ["libdisplaydebug"],
}
